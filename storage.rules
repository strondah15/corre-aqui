rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /chatAnexos/{pedidoId}/{fileName} {
      // O chat atual não usa Cloud Storage: anexos validados ficam no RTDB.
      // Rules de Storage não podem consultar participantes no Realtime Database.
      allow read, write: if false;
    }

    match /profilePhotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && fileName.matches(uid + '_.*')
        && request.resource.metadata.userId == uid
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profilePhotos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.metadata.userId == request.auth.uid
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
  }
}
