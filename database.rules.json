{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": ["online", "lastSeen", "isCorre", "isProfissional"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "userPrivate": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },
    "usuariosOnline": {
      ".indexOn": ["online", "lastSeen", "isCorre", "isProfissional"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "pedidos": {
      ".read": "auth != null",
      ".indexOn": ["status", "categoriaId", "criadoEm", "atualizadoEm", "concluidoEm"],
      "$pedidoId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('admin').val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin' || ((!data.exists() && newData.exists() && newData.child('criador/id').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('criador/id').val() === auth.uid) || (data.exists() && newData.exists() && (data.child('criador/id').val() === auth.uid || data.child('aceite/id').val() === auth.uid || (!data.child('aceite/id').exists() && newData.child('aceite/id').val() === auth.uid)))))",
        ".validate": "!newData.exists() || (newData.hasChildren(['criador', 'status']) && newData.child('criador/id').isString() && newData.child('status').isString() && (newData.child('status').val() === 'aberto' || newData.child('status').val() === 'aceito' || newData.child('status').val() === 'concluido' || newData.child('status').val() === 'cancelado'))"
      }
    },
    "avaliacoes": {
      ".read": "auth != null",
      "$pedidoId": {
        ".write": "auth != null && newData.child('cliente/id').val() === auth.uid",
        ".validate": "!newData.exists() || (newData.child('pedidoId').isString() && newData.child('nota').isNumber() && newData.child('nota').val() >= 1 && newData.child('nota').val() <= 5 && newData.child('cliente/id').isString() && newData.child('avaliado/id').isString())"
      }
    },
    "problemasServico": {
      ".read": "auth != null",
      ".indexOn": ["pedidoId", "status", "criadoEm"],
      "$registroId": {
        ".write": "auth != null && (newData.child('autor/id').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('admin').val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "!newData.exists() || (newData.child('pedidoId').isString() && newData.child('tipo').isString() && newData.child('status').isString() && newData.child('autor/id').isString())"
      }
    },
    "denuncias": {
      ".read": "auth != null",
      ".indexOn": ["pedidoId", "status", "criadoEm"],
      "$registroId": {
        ".write": "auth != null && (newData.child('autor/id').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('admin').val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "!newData.exists() || (newData.child('pedidoId').isString() && newData.child('tipo').isString() && newData.child('status').isString() && newData.child('autor/id').isString())"
      }
    },
    "missoes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "conversas": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$conversaId": {
          ".write": "auth != null && (auth.uid === $uid || (newData.exists() && ((root.child('pedidos').child($conversaId).child('criador/id').val() === auth.uid && root.child('pedidos').child($conversaId).child('aceite/id').val() === $uid) || (root.child('pedidos').child($conversaId).child('aceite/id').val() === auth.uid && root.child('pedidos').child($conversaId).child('criador/id').val() === $uid))))",
          ".validate": "!newData.exists() || newData.child('pedidoId').val() === $conversaId"
        }
      }
    },
    "usersChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$conversaId": {
          ".write": "auth != null && (auth.uid === $uid || (newData.exists() && ((root.child('pedidos').child($conversaId).child('criador/id').val() === auth.uid && root.child('pedidos').child($conversaId).child('aceite/id').val() === $uid) || (root.child('pedidos').child($conversaId).child('aceite/id').val() === auth.uid && root.child('pedidos').child($conversaId).child('criador/id').val() === $uid))))",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "notificacoes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notificacaoId": {
          ".write": "auth != null && (auth.uid === $uid || (newData.exists() && newData.child('autor/id').val() === auth.uid && newData.child('pedidoId').isString() && ((root.child('pedidos').child(newData.child('pedidoId').val()).child('criador/id').val() === auth.uid && root.child('pedidos').child(newData.child('pedidoId').val()).child('aceite/id').val() === $uid) || (root.child('pedidos').child(newData.child('pedidoId').val()).child('aceite/id').val() === auth.uid && root.child('pedidos').child(newData.child('pedidoId').val()).child('criador/id').val() === $uid))))",
          ".validate": "!newData.exists() || (newData.child('tipo').isString() && newData.child('pedidoId').isString())"
        }
      }
    },
    "agendamentos": {
      ".read": "auth != null",
      ".indexOn": ["profissionalId", "clienteId", "status", "data"],
      "$agendamentoId": {
        ".write": "auth != null && ((!data.exists() && (newData.child('clienteId').val() === auth.uid || newData.child('profissionalId').val() === auth.uid)) || (data.exists() && (data.child('clienteId').val() === auth.uid || data.child('profissionalId').val() === auth.uid)))",
        ".validate": "!newData.exists() || (newData.child('clienteId').isString() && newData.child('profissionalId').isString() && newData.child('status').isString())"
      }
    },
    "chats": {
      "$pedidoId": {
        ".read": "auth != null && (root.child('pedidos').child($pedidoId).child('criador/id').val() === auth.uid || root.child('pedidos').child($pedidoId).child('aceite/id').val() === auth.uid)",
        "$msgId": {
          ".write": "auth != null && newData.exists() && (root.child('pedidos').child($pedidoId).child('criador/id').val() === auth.uid || root.child('pedidos').child($pedidoId).child('aceite/id').val() === auth.uid) && (newData.child('userId').val() === auth.uid || newData.child('autorId').val() === 'sistema')",
          ".validate": "newData.child('criadoEm').exists() && (newData.child('texto').isString() || newData.child('audio').exists() || newData.child('anexo/url').isString() || newData.child('sistema').val() === true)"
        }
      }
    },
    "mensagens": {
      "$conversaId": {
        ".read": "auth != null && (root.child('pedidos').child($conversaId).child('criador/id').val() === auth.uid || root.child('pedidos').child($conversaId).child('aceite/id').val() === auth.uid)",
        "$msgId": {
          ".write": "auth != null && newData.exists() && (root.child('pedidos').child($conversaId).child('criador/id').val() === auth.uid || root.child('pedidos').child($conversaId).child('aceite/id').val() === auth.uid) && (newData.child('userId').val() === auth.uid || newData.child('autorId').val() === 'sistema')",
          ".validate": "newData.child('criadoEm').exists() && (newData.child('texto').isString() || newData.child('audio').exists() || newData.child('anexo/url').isString() || newData.child('sistema').val() === true)"
        }
      }
    }
  }
}
