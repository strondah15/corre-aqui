# Server-side ImgBB upload for profile photos.
IMGBB_API_KEY=
# Optional fallback used by /api/firebase-config. This is a public Web Push key, not a secret.
FIREBASE_VAPID_KEY=
OPENAI_API_KEY=

# Server-only. Use one option for Firebase Admin push/moderation routes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CREDENTIALS=

# Expo/mobile uses the EXPO_PUBLIC_ prefix at build time.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
