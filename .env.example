NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_ANUNCIO_URL=
# Server-side ImgBB upload for profile photos.
IMGBB_API_KEY=
# Optional fallback used by /api/firebase-config. This is a public Web Push key, not a secret.
FIREBASE_VAPID_KEY=
OPENAI_API_KEY=

# Development-only preview. The server ignores this flag in production.
FEATURED_PROFESSIONALS_TEST_MODE=false
FEATURED_REQUESTS_TEST_MODE=false

# Server-only commercial checkout/webhook. Do not expose with NEXT_PUBLIC_.
# Annual subscriptions reuse the same Mercado Pago credentials and webhook.
# Products: CLIENT_ANNUAL (R$ 19,90/year) and PROFESSIONAL_ANNUAL (R$ 49,90/year).
# Required environment contract before checkout can be enabled:
# - production: CORRE_AQUI_ENV=production and SITE_URL=https://www.correaquibrasil.com.br
# - staging: CORRE_AQUI_ENV=staging and SITE_URL=<the real public HTTPS staging origin>
# Do not guess the staging URL. SITE_URL must match NEXT_PUBLIC_SITE_URL when the latter is set.
CORRE_AQUI_ENV=
SITE_URL=
COMMERCIAL_HIGHLIGHTS_ENABLED=false
MERCADO_PAGO_CHECKOUT_ENABLED=false
# Server-side declaration of the credential source: test in staging, production in production.
# The Access Token is opaque; its prefix is not proof of the credential environment.
MERCADO_PAGO_CREDENTIAL_ENV=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Server-only. Use one option for Firebase Admin push/moderation routes.
# Checkout additionally requires this server-only RTDB URL and verifies it against the client URL.
FIREBASE_ADMIN_DATABASE_URL=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CREDENTIALS=

# Expo/mobile uses the EXPO_PUBLIC_ prefix at build time.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
